    \"<span class=sf-dump-key>name</span>\" => \"<span class=sf-dump-str title=\"18 characters\">Orion (The Hunter)</span>\"
    \"<span class=sf-dump-key>photo</span>\" => \"<span class=sf-dump-str title=\"27 characters\">Mauna-Kea-Observatory-3.jpg</span>\"
    \"<span class=sf-dump-key>photo_2</span>\" => \"<span class=sf-dump-str title=\"27 characters\">Mauna-Kea-Observatory-3.jpg</span>\"
