      <span class=sf-dump-str title=\"172 characters\">Betelgeuse: A huge, red-orange star on the hunter&#039;s shoulder, estimated to be about 1,000 times bigger than our Sun<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"172 characters\">Rigel: A brilliant blue-white star on the hunter&#039;s foot</span>
      \"\"\"
    \"<span class=sf-dump-key>notable_features</span>\" => \"<span class=sf-dump-str title=\"153 characters\">The Orion Nebula (M42), a giant star-forming region about 1,344 light-years away. You can often see it with your naked eye as a fuzzy patch in dark skies</span>\"
    \"<span class=sf-dump-key>myths_meaning</span>\" => \"<span class=sf-dump-str title=\"113 characters\">In Greek mythology, Orion was a great hunter. This constellation is also useful for finding nearby constellations</span>\"
  </samp>]
