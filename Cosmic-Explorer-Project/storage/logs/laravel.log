    \"<span class=sf-dump-key>id</span>\" => <span class=sf-dump-num>4</span>
    \"<span class=sf-dump-key>name</span>\" => \"<span class=sf-dump-str title=\"8 characters\">Scorpius</span>\"
    \"<span class=sf-dump-key>photo</span>\" => \"<span class=sf-dump-str title=\"26 characters\">scorpius-constellation.jpg</span>\"
    \"<span class=sf-dump-key>photo_2</span>\" => \"<span class=sf-dump-str title=\"28 characters\">scorpius-constellation-2.jpg</span>\"
    \"<span class=sf-dump-key>photo_3</span>\" => \"<span class=sf-dump-str title=\"28 characters\">scorpius-constellation-3.jpg</span>\"
    \"<span class=sf-dump-key>photo_4</span>\" => \"<span class=sf-dump-str title=\"28 characters\">scorpius-constellation-4.jpg</span>\"
    \"<span class=sf-dump-key>identify</span>\" => \"<span class=sf-dump-str title=\"247 characters\">A very bright and easily recognizable constellation, especially in the summer sky (June - September) from the Northern Hemisphere. It&#039;s located in the southern celestial hemisphere. It looks like a winding scorpion with a curved tail and a stinger</span>\"
    \"<span class=sf-dump-key>main_stars</span>\" => \"<span class=sf-dump-str title=\"155 characters\">Antares: A supergiant red star, known as the &quot;heart of the Scorpion.&quot; It&#039;s one of the brightest stars in the night sky, about 700 times larger than our Sun</span>\"
    \"<span class=sf-dump-key>notable_features</span>\" => \"<span class=sf-dump-str title=\"160 characters\">Contains many beautiful open star clusters like M6 (the Butterfly Cluster) and M7 (Ptolemy&#039;s Cluster). This area is also famous for its interesting dark nebulae</span>\"
    \"<span class=sf-dump-key>myths_meaning</span>\" => \"<span class=sf-dump-str title=\"201 characters\">One of the 12 Zodiac constellations. It&#039;s connected to the myth of Orion&#039;s death, where the Scorpion killed the great hunter. This is why the two constellations never appear in the sky at the same time</span>\"
  </samp>]
