","post":"<pre class=sf-dump id=sf-dump-1352828994 data-indent-pad=\"  \"><span class=sf-dump-note>App\\Models\\Discovery</span> {<a class=sf-dump-ref>#1360</a><samp data-depth=1 class=sf-dump-expanded>
