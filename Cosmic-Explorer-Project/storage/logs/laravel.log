","discovery":"<pre class=sf-dump id=sf-dump-150827833 data-indent-pad=\"  \"><span class=sf-dump-note>App\\Models\\Discovery</span> {<a class=sf-dump-ref>#1301</a><samp data-depth=1 class=sf-dump-expanded>
  #<span class=sf-dump-protected title=\"Protected property\">connection</span>: \"<span class=sf-dump-str title=\"5 characters\">mysql</span>\"
