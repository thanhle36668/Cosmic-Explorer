    \"<span class=sf-dump-key>id</span>\" => <span class=sf-dump-num>5</span>
    \"<span class=sf-dump-key>name</span>\" => \"<span class=sf-dump-str title=\"22 characters\">Cassiopeia (The Queen)</span>\"
    \"<span class=sf-dump-key>photo</span>\" => \"<span class=sf-dump-str title=\"28 characters\">cassiopeia-constellation.jpg</span>\"
    \"<span class=sf-dump-key>photo_2</span>\" => \"<span class=sf-dump-str title=\"30 characters\">cassiopeia-constellation-2.jpg</span>\"
    \"<span class=sf-dump-key>photo_3</span>\" => \"<span class=sf-dump-str title=\"30 characters\">cassiopeia-constellation-3.jpg</span>\"
    \"<span class=sf-dump-key>photo_4</span>\" => \"<span class=sf-dump-str title=\"30 characters\">cassiopeia-constellation-4.jpg</span>\"
    \"<span class=sf-dump-key>identify</span>\" => \"<span class=sf-dump-str title=\"234 characters\">A bright constellation, easy to find in the Northern Hemisphere all year round (it&#039;s circumpolar). It&#039;s distinctly shaped like a large &quot;W&quot; or &quot;M&quot; (depending on the time of night). It appears opposite the North Star from the Big Dipper</span>\"
    \"<span class=sf-dump-key>main_stars</span>\" => \"<span class=sf-dump-str title=\"72 characters\">The stars forming the W/M shape, like Schedar and Caph, are quite bright</span>\"
    \"<span class=sf-dump-key>notable_features</span>\" => \"<span class=sf-dump-str title=\"221 characters\">Located within the Milky Way, Cassiopeia contains many open star clusters and nebulae, such as the Heart Nebula (IC 1805) and the Soul Nebula (IC 1848). It&#039;s also the location of Cassiopeia A, a powerful supernova remnant</span>\"
    \"<span class=sf-dump-key>myths_meaning</span>\" => \"<span class=sf-dump-str title=\"221 characters\">In Greek mythology, Cassiopeia was a boastful queen punished by being placed in the sky, sometimes upside down. This constellation is also a useful landmark for finding other constellations and objects in the northern sky</span>\"
  </samp>]
