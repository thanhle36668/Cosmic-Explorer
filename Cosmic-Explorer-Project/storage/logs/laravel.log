    \"<span class=sf-dump-key>identify</span>\" => \"<span class=sf-dump-str title=\"208 characters\">A bright constellation, especially noticeable in the spring sky (March - June) from the Northern Hemisphere. It looks like a reclining lion, clearly identified by the Sickle shape that forms its head and mane</span>\"
    \"<span class=sf-dump-key>main_stars</span>\" => \"<span class=sf-dump-str title=\"53 characters\">Regulus: The brightest star, marking the lion&#039;s heart</span>\"
    \"<span class=sf-dump-key>main_stars_2</span>\" => \"<span class=sf-dump-str title=\"61 characters\">Denebola: The second brightest star, found at the lion&#039;s tail</span>\"
    \"<span class=sf-dump-key>notable_features</span>\" => \"<span class=sf-dump-str title=\"147 characters\">Notable Features: Home to several interesting galaxies, especially the Leo Triplet (M65, M66, NGC 3628), a group of three beautiful spiral galaxies</span>\"
    \"<span class=sf-dump-key>myths_meaning</span>\" => \"<span class=sf-dump-str title=\"108 characters\">One of the 12 Zodiac constellations. In Greek mythology, it represents the Nemean Lion, defeated by Hercules</span>\"
